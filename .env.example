# SmartBusAI — environment configuration template.
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Server ──
PORT=2704
NODE_ENV=development
# Process timezone. Every naive DATETIME column in this DB stores Vietnam
# local wall-clock time (see server/utils/dateTime.js) — do not change this
# unless the DB's time contract also changes.
TZ=Asia/Ho_Chi_Minh
# Public base URL this server is reachable at — used to build payment
# gateway callback URLs (MoMo/VNPay redirect+notify). Must match how the
# gateway (or your reverse proxy) actually reaches this container.
BASE_URL=http://localhost:2704
# Comma-separated list of additional allowed CORS origins, on top of the
# built-in defaults (localhost:2704, 127.0.0.1:2704, LAN 192.168.x.x, and
# *.smartbusai.vn). Only needed for a deployment host that doesn't match
# any of those, e.g. a staging domain.
CORS_ORIGIN=

# ── Database ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartbusai

# ── Cache (Enterprise Hardening Pass — Pillar 3) ──
# Optional. cacheManager.js falls back to an in-memory cache automatically
# if Redis is unset or unreachable — the app runs correctly either way,
# just faster on shared reads (public stats, trending trips) when this is
# set. REDIS_URL takes priority; REDIS_HOST/REDIS_PORT are used to build
# one if REDIS_URL is unset. docker-compose.yml sets REDIS_URL=redis://redis:6379
# automatically for the containerized backend.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Secrets — REQUIRED in any real deployment ──
# If unset, the server generates a random per-process secret at startup and
# logs a loud warning (see server/config/jwtSecret.js /
# server/config/qrSecret.js) — every previously issued JWT / QR checksum
# stops validating on the next restart. Fine for a single local dev
# session; never rely on the fallback in production.
JWT_SECRET=
# HMAC secret for the "tamper-proof" booking QR checksum
# (server/services/qrService.js). Same random-fallback-with-warning
# behavior as JWT_SECRET if left unset.
QR_SECRET=

# ── Payment gateways (demo/sandbox mode) ──
# SmartBusAI's payment flow is an explicitly-labeled simulation for thesis
# purposes (see the in-app "demo mode" notice on the payment screen) — it
# never calls a real bank/gateway signature-verification path. The values
# below, if left unset, default to MoMo's and VNPay's own publicly
# published SANDBOX test-merchant credentials (server/config/payment.config.js)
# — safe to leave blank for local/demo use. Replace with real merchant
# credentials only if wiring this up to an actual production gateway.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# ── Google Sign-In (optional) ──
# Leave unset to disable Google login — authController returns a clear 503
# ("Google OAuth chưa được cấu hình trên server") instead of failing open.
GOOGLE_CLIENT_ID=

# ── Facebook Login (optional, Sprint 7) ──
# Leave FACEBOOK_APP_ID unset to disable Facebook login — same fail-closed
# 503 pattern as Google above. Never put the App Secret anywhere the
# frontend can read it — only FACEBOOK_APP_ID is exposed via
# GET /api/auth/facebook-config; FACEBOOK_APP_SECRET stays server-only,
# used only to build the app access token for Graph API's debug_token check.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Outbound email (optional) ──
# Leave SMTP_HOST unset to disable real email sending — trip-reminder /
# booking-confirmation emails are simply skipped, not an error.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
